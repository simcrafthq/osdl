{
  "$schema": "https://osdl.dev/schemas/0.1/osdl.schema.json",
  "osdl": "0.1",
  "model": {
    "name": "despipe",
    "components": [
      {
        "id": "src",
        "type": "des.source",
        "params": {
          "interarrival": 1.0,
          "entityType": "src",
          "limit": 4
        }
      },
      {
        "id": "q",
        "type": "des.queue",
        "params": {"capacity": 2}
      },
      {
        "id": "srv",
        "type": "des.server",
        "params": {"serviceTime": 1.5}
      },
      {
        "id": "snk",
        "type": "des.sink"
      }
    ],
    "connections": [
      {"from": "src.out", "to": "q.in"},
      {"from": "q.out", "to": "srv.in"},
      {"from": "srv.out", "to": "snk.in"}
    ]
  },
  "experiments": [
    {
      "name": "workload",
      "duration": 12,
      "seed": 5
    }
  ]
}
