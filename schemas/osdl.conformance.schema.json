{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osdl.dev/schemas/0.1/osdl.conformance.schema.json",
  "title": "OSDL Conformance Manifest",
  "description": "A conformance module and its test cases.",
  "type": "object",
  "required": ["osdl", "kind", "id", "version", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "osdl": {"const": "0.1"},
    "kind": {
      "type": "string",
      "enum": ["core", "library", "contract"]
    },
    "id": {"$ref": "#/$defs/moduleId"},
    "version": {"$ref": "#/$defs/version"},
    "extends": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/moduleReference"}
    },
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/case"}
    },
    "assertions": {
      "type": "array",
      "items": {"$ref": "#/$defs/assertion"}
    }
  },
  "$defs": {
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "moduleReference": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "case": {
      "type": "object",
      "required": ["id", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {"type": "string"},
        "input": {"$ref": "#/$defs/input"},
        "expected": {"$ref": "#/$defs/expected"}
      }
    },
    "input": {
      "type": "object",
      "required": ["format", "path"],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": ["osdl", "machine"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expected": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "results": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "string",
          "minLength": 1
        },
        "trace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assertion": {
      "type": "object",
      "required": ["case"],
      "minProperties": 2,
      "additionalProperties": false,
      "properties": {
        "case": {
          "type": "string",
          "minLength": 1
        },
        "results": {"$ref": "#/$defs/resultAssertion"},
        "events": {"$ref": "#/$defs/artifactAssertion"},
        "trace": {"$ref": "#/$defs/artifactAssertion"}
      }
    },
    "resultAssertion": {
      "type": "object",
      "required": ["comparison"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "comparison": {
          "type": "object",
          "required": ["floatMode"],
          "additionalProperties": false,
          "properties": {
            "floatMode": {
              "type": "string",
              "enum": ["bits", "number"],
              "description": "Numeric result comparison. `bits` is the default and distinguishes positive zero from negative zero. `number` treats both zero signs as equal. Child modules can preserve a policy or strengthen `number` to `bits`, but cannot weaken `bits` to `number`."
            }
          }
        }
      }
    },
    "artifactAssertion": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
